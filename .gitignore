/mailpit/
/config/mail-catcher.txt
/_mailpit.zip
/_mailpit.zip.part
/_mailpit_tmp/

# Error and network catchers: on/off choices, read marks, muted sites, blocking rules
/config/error-catcher.txt
/config/error-catcher-seen.json
/config/error-alerts-muted.json
/config/network-catcher.txt
/config/network-rules.json

# The app's own preferences (Settings page); the server has defaults when it's missing
/config/app-settings.json

# Stack page's PHP & MySQL settings and the ini file PHP reads from them
/config/php-tuning.json
/config/php-ini/
